generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 1. Users & Authentication
model User {
  id                 String               @id @default(cuid())
  email              String               @unique
  passwordHash       String
  name               String
  phone              String?
  role               String               @default("CUSTOMER") // CUSTOMER, ADMIN, STAFF
  isEmailVerified    Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  profile            CustomerProfile?
  addresses          Address[]
  orders             Order[]
  reviews            Review[]
  wishlist           Wishlist[]
  loyaltyLedger      LoyaltyTransaction[]
  auditLogs          AuditLog[]
  couponRedemptions  CouponRedemption[]

  @@index([email])
}

// 2. Customer Profile & Loyalty
model CustomerProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loyaltyPoints Int      @default(0)
  referralCode  String   @unique
  referredBy    String?
  skinType      String?
  concerns      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// 3. Address Management
model Address {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  phone       String
  street      String
  landmark    String?
  city        String
  state       String
  pinCode     String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([pinCode])
}

// 4. Skincare Brands
model Brand {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  origin      String    @default("Seoul, South Korea")
  tagline     String?
  description String?
  logo        String?
  createdAt   DateTime  @default(now())
  products    Product[]
}

// 5. Product Categories
model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  createdAt   DateTime  @default(now())
  products    Product[]
}

// 6. Products
model Product {
  id               String           @id @default(cuid())
  slug             String           @unique
  name             String
  brandId          String?
  brand            Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categoryId       String?
  category         Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory      String?
  shortDescription String
  description      String
  price            Float
  mrp              Float
  rating           Float            @default(5.0)
  reviewCount      Int              @default(0)
  images           String // JSON stringified array of image URLs
  skinType         String // JSON stringified array
  concerns         String // JSON stringified array
  keyIngredients   String // JSON stringified array of {name, benefit}
  fullIngredients  String
  howToUse         String
  cautions         String?
  status           String           @default("ACTIVE") // ACTIVE, DRAFT, ARCHIVED
  isBestSeller     Boolean          @default(false)
  isNewArrival     Boolean          @default(false)
  isTrending       Boolean          @default(false)
  inStock          Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  variants         ProductVariant[]
  reviews          Review[]
  wishlist         Wishlist[]

  @@index([slug])
  @@index([brandId])
  @@index([categoryId])
}

// 7. Product Variants & SKUs
model ProductVariant {
  id        String      @id @default(cuid())
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String      @unique
  size      String
  price     Float
  mrp       Float
  barcode   String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  inventory Inventory?

  @@index([productId])
  @@index([sku])
}

// 8. Inventory & Stock Auditing
model Inventory {
  id                String              @id @default(cuid())
  variantId         String              @unique
  variant           ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantityOnHand    Int                 @default(0)
  reservedQuantity  Int                 @default(0)
  lowStockThreshold Int                 @default(5)
  updatedAt         DateTime            @updatedAt

  movements         InventoryMovement[]
}

model InventoryMovement {
  id          String    @id @default(cuid())
  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  type        String // RESTOCK, SALE, RETURN, RESERVATION, RELEASE, ADJUSTMENT
  quantity    Int
  reason      String?
  createdAt   DateTime  @default(now())

  @@index([inventoryId])
}

// 9. Shopping Cart
model Cart {
  id        String     @id @default(cuid())
  userId    String?
  sessionId String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]

  @@index([userId])
  @@index([sessionId])
}

model CartItem {
  id            String   @id @default(cuid())
  cartId        String
  cart          Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId     String
  quantity      Int      @default(1)
  priceSnapshot Float
  createdAt     DateTime @default(now())

  @@index([cartId])
}

// 10. Orders & Order Items (Immutable Historic Price Snapshots)
model Order {
  id              String             @id @default(cuid())
  orderNumber     String             @unique
  userId          String?
  user            User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName    String
  customerEmail   String
  customerPhone   String
  shippingAddress String // JSON stringified address details
  subtotal        Float
  discountTotal   Float              @default(0)
  shippingFee     Float              @default(0)
  taxTotal        Float              @default(0)
  grandTotal      Float
  status          String             @default("PENDING") // PENDING, CONFIRMED, PROCESSING, SHIPPED, OUT_FOR_DELIVERY, DELIVERED, CANCELLED, REFUNDED
  paymentStatus   String             @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  paymentMethod   String             @default("COD") // COD, RAZORPAY, CASHFREE
  couponCode      String?
  trackingNumber  String?
  courierName     String?
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  items           OrderItem[]
  payments        Payment[]
  shipments       Shipment[]
  redemptions     CouponRedemption[]
  notifications   NotificationLog[]

  @@index([orderNumber])
  @@index([userId])
  @@index([status])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  variantId   String?
  productName String
  brandName   String
  size        String?
  unitPrice   Float
  taxAmount   Float   @default(0)
  quantity    Int
  subtotal    Float

  @@index([orderId])
}

// 11. Payments & Webhooks
model Payment {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gateway           String // RAZORPAY, CASHFREE, COD, MOCK
  transactionId     String   @unique
  amount            Float
  status            String // PENDING, SUCCESS, FAILED, REFUNDED
  signatureVerified Boolean  @default(false)
  gatewayResponse   String? // JSON stringified webhook payload
  createdAt         DateTime @default(now())

  @@index([orderId])
  @@index([transactionId])
}

// 12. Complete Coupon Engine
model Coupon {
  id                String             @id @default(cuid())
  code              String             @unique
  discountType      String // PERCENTAGE, FIXED, FREE_SHIPPING, BOGO
  discountValue     Float
  minOrderValue     Float              @default(0)
  maxDiscountCap    Float?
  totalUsageLimit   Int?
  perCustomerLimit  Int                @default(1)
  usedCount         Int                @default(0)
  startDate         DateTime           @default(now())
  endDate           DateTime?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  redemptions       CouponRedemption[]

  @@index([code])
}

model CouponRedemption {
  id             String   @id @default(cuid())
  couponId       String
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  discountAmount Float
  createdAt      DateTime @default(now())

  @@index([couponId])
  @@index([orderId])
}

// 13. Shipment & Logistics
model Shipment {
  id           String    @id @default(cuid())
  orderId      String
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier      String
  awbNumber    String    @unique
  trackingUrl  String?
  status       String    @default("MANIFESTED")
  dispatchedAt DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([orderId])
  @@index([awbNumber])
}

// 14. Customer Reviews & Moderation
model Review {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId             String?
  user               User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName       String
  rating             Int      @default(5)
  title              String?
  comment            String
  isVerifiedPurchase Boolean  @default(true)
  isApproved         Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@index([productId])
  @@index([isApproved])
}

// 15. Wishlist
model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

// 16. Loyalty Points Ledger
model LoyaltyTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // EARNED, REDEEMED, EXPIRED
  points    Int
  reason    String
  orderId   String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// 17. Notification Service Logs (WhatsApp / Email)
model NotificationLog {
  id               String   @id @default(cuid())
  orderId          String?
  order            Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  channel          String // WHATSAPP, EMAIL, SMS
  event            String // ORDER_PLACED, SHIPPED, DELIVERED, ABANDONED_CART
  recipient        String
  status           String // SENT, FAILED, DELIVERED
  providerResponse String?
  createdAt        DateTime @default(now())

  @@index([channel])
  @@index([status])
}

// 18. AI Product Studio Jobs & Creative Assets
model AIJob {
  id           String    @id @default(cuid())
  type         String // CREATIVE_GENERATION, COPY_DRAFT, SEO_ENHANCE, TRANSLATION
  status       String    @default("COMPLETED") // PENDING, COMPLETED, FAILED, APPROVED, REJECTED
  inputData    String // JSON input
  outputData   String // JSON output
  costEstimate Float     @default(0.0)
  createdAt    DateTime  @default(now())
  assets       AIAsset[]
}

model AIAsset {
  id           String   @id @default(cuid())
  jobId        String
  job          AIJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  assetType    String // IMAGE, COPY, SOCIAL_CAPTION, SEO_TAG
  url          String?
  templateName String?
  approved     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([jobId])
}

// 19. Store Settings
model StoreSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// 20. Audit Trail
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  resource  String
  details   String?
  createdAt DateTime @default(now())

  @@index([action])
}
