{
  "name": "blumac-korean-store",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/deploy-build.mjs && prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:generate:local": "prisma generate --schema=prisma/schema.sqlite.prisma",
    "db:generate:mysql": "prisma generate --schema=prisma/schema.prisma",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.mjs",
    "test": "node --test --experimental-strip-types tests/ecommerce.test.mjs tests/ai-studio.test.mjs tests/admin-panel.test.mjs",
    "test:integration": "node scripts/comprehensive-local-test.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.1.7",
    "postcss": "^8.5.1",
    "prisma": "^6.3.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
