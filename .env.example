# ==============================================================================
# BLUMAC Korean Store - Environment Variables Configuration
# ==============================================================================

# Database Connection (Default: local SQLite database for zero-friction local development)
# For Hostinger / Production PostgreSQL:
# DATABASE_URL="postgresql://username:password@hostname:5432/blumac_db?schema=public"
DATABASE_URL="file:./dev.db"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication & Session Security (Generate a secure 32+ character random string in production)
JWT_SECRET="blumac-korean-store-jwt-secret-key-change-in-production-2026"
SESSION_MAX_AGE_DAYS=30

# Admin Seed Credentials
ADMIN_DEFAULT_EMAIL="admin@blumac.in"
ADMIN_DEFAULT_PASSWORD="BlumacAdmin@2026"
ADMIN_SECURITY_PIN="98102"

# Payment Gateway: Razorpay (India)
# Sign up at https://razorpay.com for Indian UPI, Cards & NetBanking
RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="placeholder_secret"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

# Payment Gateway: Cashfree (India - Optional secondary)
CASHFREE_APP_ID="placeholder_cashfree_app_id"
CASHFREE_SECRET_KEY="placeholder_cashfree_secret"
CASHFREE_ENVIRONMENT="TEST" # TEST or PRODUCTION

# WhatsApp Business API (Optional - Official WhatsApp Business Platform or Gupshup/Wati)
WHATSAPP_ENABLED="false"
WHATSAPP_API_TOKEN="placeholder_whatsapp_token"
WHATSAPP_PHONE_NUMBER_ID="placeholder_phone_number_id"
WHATSAPP_BUSINESS_ACCOUNT_ID="placeholder_waba_id"

# Email Delivery (SMTP / Resend / SendGrid)
EMAIL_ENABLED="false"
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="care@blumac.in"
SMTP_PASS="placeholder_email_password"
EMAIL_FROM="BLUMAC Korean Store <care@blumac.in>"

# AI Product Studio (Google Gemini API / Pluggable Provider)
# Acquire key at https://aistudio.google.com/
GEMINI_API_KEY="placeholder_gemini_api_key"

# Courier Aggregator (Shiprocket / Delhivery Direct / Bluedart Apex)
SHIPROCKET_EMAIL="placeholder_courier_email"
SHIPROCKET_PASSWORD="placeholder_courier_password"
